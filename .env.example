# ─── Hubstaff API ─────────────────────────────────────────────────────────────
# Obtain from: https://developer.hubstaff.com/personal_access_tokens
# Required scopes: openid, profile, email, hubstaff:read
HUBSTAFF_PERSONAL_ACCESS_TOKEN=your_pat_here

# Your Hubstaff Organization ID (numeric).
# Find it at: https://app.hubstaff.com/organizations → URL bar shows the org ID
HUBSTAFF_ORG_ID=your_org_id_here

# Optional: cache TTL in seconds (default 300 = 5 min)
HUBSTAFF_CACHE_TTL=300
